# Copy to .env on the VPS:  cp .env.example .env   then fill in real values.

# ---- Payload ----
# Generate with:  openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING

# Public URL of the CMS (the domain you set up in aaPanel)
NEXT_PUBLIC_SERVER_URL=https://cms.yourdomain.com

# Comma-separated list of Next.js frontends allowed to call the API (CORS + CSRF)
FRONTEND_URLS=https://www.yourdomain.com,https://client-site.com,http://localhost:3000

# Shared secret used to tell your frontends to revalidate cached pages
REVALIDATE_SECRET=CHANGE_ME_ANOTHER_RANDOM_STRING

# Host port Payload listens on (localhost only). Change if 3001 is taken on the VPS.
PAYLOAD_PORT=3001

# ---- PostgreSQL ----
POSTGRES_USER=payload
# Generate with:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=payload

# ---- Media storage: Cloudflare R2 (S3-compatible) ----
# Leave these blank/unset to store uploads on local disk instead.
# From Cloudflare dashboard > R2 > your bucket, and R2 > Manage API Tokens.
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
